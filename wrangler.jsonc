{
	// ⚠ Deployed only from .github/workflows/check.yml, after every check is green, on push to main
	//   (docs/adr/0010). ⚠ wrangler's version is pinned there, once.
	"name": "decide-first",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-11",
	// ⚠ Only public/: index.html and view.js. Pointing this at src/ would publish the TypeScript.
	"assets": {
		"directory": "./public"
	}
}
